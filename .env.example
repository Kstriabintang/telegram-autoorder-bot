# ============================================================
#  Copy file ini menjadi .env, lalu isi tiap nilai di bawah.
#  JANGAN commit file .env (sudah di-ignore oleh .gitignore).
# ============================================================

# --- Telegram ---
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID Telegram owner penerima notifikasi penjualan.
# Boleh lebih dari satu, pisahkan dengan koma. Contoh: 12345678,87654321
OWNER_USER_ID=
# Username/kontak owner yang ditampilkan di menu Bantuan. Contoh: @username
OWNER_CONTACT=

# --- Supabase ---
# Project URL dari dashboard Supabase > Project Settings > API
SUPABASE_URL=
# service_role key (bypass RLS, untuk backend). RAHASIA — jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# --- Pakasir (payment gateway QRIS) ---
# Slug & API key dari dashboard Pakasir.com
PAKASIR_SLUG=
PAKASIR_API_KEY=

# --- Produk ---
# Nama produk yang ditampilkan ke user. Contoh: Digital Product
PRODUCT_NAME=
# Harga per item dalam Rupiah (angka saja, tanpa titik). Contoh: 50000
PRODUCT_PRICE=
# (Opsional) URL gambar banner untuk pesan /start. Kosongkan jika tidak ada.
BANNER_URL=
